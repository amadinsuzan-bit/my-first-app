  <properties>
                                
    
    
    
    
    
    <cn1.plugin.version>7.0.269</cn1.plugin.version>
    <!-- Build progress reporting from Maven, for builds the launchers never see (the
         IDE's run configurations, mvn by hand); see the README. The Codename One
         Maven plugin reports only when both are set; CN1_TELEMETRY=0 turns it off. -->
    <cn1.telemetry.project>co.cn1.my.first.app.dp3oo5vf</cn1.telemetry.project>
    <cn1.telemetry.events>https://cloud.codenameone.com/api/v2/onboarding/starter-event</cn1.telemetry.events>
                                
    
    
    
    
    
    <cn1.version>7.0.269</cn1.version>
                                
    
    
    
    
    
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                        	      
        
    
    
    
    
    
    <java.version>1.8</java.version>
                                
    
    
    
    
    
    <java-tests.version>11</java-tests.version>
                                
    
    
    
    
    
    <rhino.version>1.7.11</rhino.version>
                                
    
    
    
    
    
